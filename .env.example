# Database configuration (Supabase PostgreSQL Connection String)
# Example: postgresql://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL="postgresql://username:password@hostname:5432/dbname?ssl=require"

# JWT configuration for Authentication
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Port (optional)
PORT=3000
